[Unit]
Description=Build and restart Hugin after new commit

[Service]
Type=oneshot
User=magnus
WorkingDirectory=/home/magnus/repos/hugin
# hugin.service is a *user* unit; the system manager can only reach it
# when XDG_RUNTIME_DIR points at the user's runtime dir (uid 1000).
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PATH=/home/magnus/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
# Install devDependencies (typescript/tsc) before building — node_modules
# on the Pi may have been provisioned production-only.
ExecStart=/bin/sh -c 'npm install --include=dev && npm run build'
ExecStartPost=/usr/bin/systemctl --user restart hugin.service
