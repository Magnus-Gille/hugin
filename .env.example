# Required Munin connection. Replace the placeholder locally; never commit it.
MUNIN_URL=http://127.0.0.1:3030
MUNIN_API_KEY=replace-with-a-random-local-secret

# Hugin HTTP listener and polling.
HUGIN_HOST=127.0.0.1
HUGIN_PORT=3032
HUGIN_POLL_INTERVAL_MS=30000
HUGIN_DEFAULT_TIMEOUT_MS=300000
HUGIN_MAX_OUTPUT_CHARS=50000

# Use task-only directories, never production deployment checkouts.
HUGIN_REPOS_ROOT=/var/lib/hugin/worktrees
HUGIN_WORKSPACE=/var/lib/hugin/workspace

# The submitter field is a claim unless signing is enabled.
HUGIN_ALLOWED_SUBMITTERS=local-client
HUGIN_OWNER_SUBMITTERS=local-client
HUGIN_SIGNING_POLICY=warn
HUGIN_SIGNING_MAX_AGE_S=900
# HUGIN_SUBMITTER_KEYS_FILE=/etc/hugin/submitter-keys.json

# Local Ollama is optional. Leave remote endpoints empty when unused.
OLLAMA_PI_URL=http://127.0.0.1:11434
OLLAMA_LAPTOP_URL=
OLLAMA_ORIN_URL=
OLLAMA_DEFAULT_MODEL=qwen2.5:3b

# Optional operator-controlled OpenAI-compatible gateway.
HOMESERVER_GATEWAY_URL=
HOMESERVER_GATEWAY_API_KEY=

# Artifact delivery has no default target. Empty means no destination is
# allowed. Set a JSON array only after configuring SSH and a staging directory.
HUGIN_DELIVERY_POLICY=require
HUGIN_DELIVERY_TARGETS=

# Security policies. Review the linked security docs before relaxing these.
HUGIN_EXFIL_POLICY=flag
HUGIN_EXTERNAL_POLICY=block
HUGIN_ALLOWED_EGRESS_HOSTS=

# Optional authenticated Broker. Prefer a mode-0600 JSON file over inline keys.
# HUGIN_BROKER_KEYS_FILE=/etc/hugin/broker-keys.json
HUGIN_BROKER_HOST=127.0.0.1
HUGIN_BROKER_PORT=3033
